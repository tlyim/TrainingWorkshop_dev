FROM ghcr.io/tlyim/rpython:latest

ARG USERNAME=codespace
ARG USER_UID=1000
ARG USER_GID=1000

RUN existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1)" \
    && if [ -n "$existing_user" ] && [ "$existing_user" != "$USERNAME" ]; then \
         usermod --login "$USERNAME" "$existing_user" \
         && usermod --move-home --home "/home/$USERNAME" "$USERNAME"; \
       elif [ -z "$existing_user" ]; then \
         groupadd --gid "$USER_GID" "$USERNAME" \
         && useradd --uid "$USER_UID" --gid "$USER_GID" \
            --create-home --shell /bin/bash "$USERNAME"; \
       fi \
    && usermod --gid "$USER_GID" --shell /bin/bash "$USERNAME" \
    && usermod -aG sudo "$USERNAME" \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" \
       > "/etc/sudoers.d/$USERNAME" \
    && chmod 0440 "/etc/sudoers.d/$USERNAME"

ENV BUN_INSTALL=/usr/local/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

RUN python3 -m pip install --break-system-packages uv \
   && uv pip install --system --python python3 \
      ipykernel \
      nbformat \
      pyreadr \
      stargazer

RUN mkdir -p "${BUN_INSTALL}" \
   && curl -fsSL https://bun.sh/install | bash \
   && bun add -g opencode-ai \
   && bun --version \
   && opencode --version

ENV HOME=/home/codespace
WORKDIR /workspaces